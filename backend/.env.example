NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/bugfixai
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d

STORAGE_ROOT=./storage
SANDBOX_WORK_ROOT=./sandbox-work
MAX_UPLOAD_BYTES=524288000
SANDBOX_TIMEOUT_MS=300000
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK_MODE=none

GITHUB_API_URL=https://api.github.com
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- AI providers ---
# Every signed-in user shares whichever of these keys you configure here — there's
# no per-user setup. Add at least ONE key below to make the Agent chat / bug
# diagnosis / fix generation work. Recommended (free): GROQ_API_KEY or GOOGLE_API_KEY.
#   GROQ_API_KEY    -> free tier, hosts GPT-OSS + Llama models. Get one: https://console.groq.com/keys
#   GOOGLE_API_KEY  -> free tier, Gemini models. Get one:          https://aistudio.google.com/apikey
#   OPENROUTER_API_KEY -> some models are free (":free" suffix).   https://openrouter.ai/keys
#   OPENAI_API_KEY / ANTHROPIC_API_KEY -> no free API tier; these need a paid key to work.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Used only as a last-resort fallback if nothing free is configured above.
DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=openai/gpt-oss-120b

ENCRYPTION_KEY=replace-with-a-random-32-plus-character-key
LOG_LEVEL=info
